      "css": ".ds-tile { border: 1px solid var(--line); background: var(--surface); } .ds-tile-head { display: flex; align-items: center; gap: 10px; min-height: 36px; padding: 0 6px 0 14px; border-bottom: 1px solid var(--line); background: var(--surface-2); font: 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); } .ds-tile-kind { color: var(--green-ink); } .ds-tile-title { flex: 1; color: var(--ink-2); } .ds-tile-head button { height: 26px; padding: 0 9px; border: 0; background: transparent; color: var(--muted); font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; } .ds-tile-head button:hover { color: var(--ink); background: var(--surface-3); } .ds-tile-body { padding: 16px 18px 18px; display: grid; gap: 9px; } .ds-bar { height: 10px; background: var(--track); } .ds-bar i { display: block; height: 100%; background: var(--s1); }"
    },
