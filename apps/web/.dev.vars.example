GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_SLUG=replace-with-github-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-pem-content\n-----END RSA PRIVATE KEY-----"
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
OAUTH_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
# Optional: a Google Cloud API key restricted to the Chrome UX Report and PageSpeed Insights APIs (real-user speed and lab scores).
GOOGLE_API_KEY=
# Optional: an Open PageRank key (free, openpagerank.keywordseverywhere.com) for the authority estimate.
OPEN_PAGERANK_KEY=
# Optional: DataForSEO API login and API password (app.dataforseo.com → API Access), for keyword volume, difficulty, competitor keywords,
# search results pages and search competitors, and backlinks (the Backlinks API must be active on the account).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: a Bing Webmaster Tools API key (Settings → API access) for Bing clicks, impressions and crawl counts. Verify the site in that Bing account.
BING_WEBMASTER_API_KEY=
# Optional language model for scoping, extraction, and page copy. The first key that is set wins:
# DEEPSEEK_API_KEY (default model deepseek-flash), then ANTHROPIC_API_KEY (claude-opus-5-5), then Workers AI.
# ANTHROPIC_API_KEY and LLM_MODEL are only loaded locally once declared in cloudflare.config.ts (see the note there).
# Workers AI needs Cloudflare credentials in local development, so set one of these keys to use the AI steps locally.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override for the active provider, e.g. deepseek-v4-pro for higher-quality scoping and copy.
LLM_MODEL=

# Accounts. At least 32 random characters; not the same as SESSION_SECRET.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Owners of the workspace holding the pre-accounts sites, and of /admin. Comma-separated.
BOOTSTRAP_OWNER_EMAIL=you@example.com
# Cloudflare Turnstile test keys (always pass) for local dev; real keys from the Turnstile dashboard in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The GitHub App's Client ID and a client secret (GitHub App settings → General).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional, off until Workers Paid: email sign-in and verification, and password sign-in (needs email).
# EMAIL_ENABLED=true
# EMAIL_FROM=no-reply@your-domain
# PASSWORD_SIGNIN=true
