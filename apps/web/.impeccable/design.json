      "css": ".ds-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border: 1px solid var(--line); background: var(--surface); overflow: hidden; } .ds-kpi { padding: 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; } .ds-kpi span { display: block; font: 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); } .ds-kpi strong { display: block; margin: 10px 0 2px; font: 400 28px var(--sans); letter-spacing: -.02em; font-variant-numeric: tabular-nums; color: var(--ink); } .ds-kpi small { font-size: 12px; color: var(--muted); }"
