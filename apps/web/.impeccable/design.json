      "css": ".ds-conn { width: 100%; display: flex; align-items: center; flex-wrap: wrap; gap: 6px 18px; padding: 11px 16px; border: 1px solid var(--line); background: var(--surface); color: var(--soft); font: 11.5px var(--mono); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background-color .2s; } .ds-conn span { display: inline-flex; align-items: center; gap: 7px; } .ds-conn span:not(.ds-conn-label, .ds-conn-open)::before { content: \"\"; width: 6px; height: 6px; border: 1px solid var(--soft); } .ds-conn span.on { color: var(--ink-2); } .ds-conn span.on::before { border-color: var(--green); background: var(--green); } .ds-conn-label { color: var(--muted); } .ds-conn-open { margin-left: auto; color: var(--green-ink); transition: transform .2s var(--ease); } .ds-conn:hover { background: var(--surface-2); } .ds-conn:hover .ds-conn-open { transform: translateX(3px); }"
    },
