{
  "name": "@organic-growth/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@organic-growth/agents": "*",
    "@organic-growth/ai": "*",
    "@organic-growth/core": "*",
    "@organic-growth/crawler": "*",
    "@organic-growth/db": "*",
    "@organic-growth/pages": "*",
    "@organic-growth/repo-analyzer": "*",
    "@organic-growth/scraper": "*",
    "@organic-growth/sdk": "*",
    "@vinext/cloudflare": "^1.0.1",
    "d3-force": "^3.0.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@tailwindcss/postcss": "latest",
    "@types/d3-force": "^3.0.10",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@cloudflare/workers-types": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "^1.0.0-beta.12",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5174 --strictPort",
    "build": "vite build",
    "start": "vite preview",
    "db:migrate:local": "cf d1 migrations apply 591e4045-cbff-4ef4-a894-cbe4ece424ec --local --persist-to ./.cloudflare/state --dir ../../packages/db/migrations",
    "db:migrate:remote": "cf d1 migrations apply 591e4045-cbff-4ef4-a894-cbe4ece424ec --dir ../../packages/db/migrations",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types -q && tsc --noEmit -p .",
    "test": "node --test \"app/**/*.test.ts\""
  }
}
