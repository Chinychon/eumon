      "css": ".ds-nav { display: flex; align-items: center; gap: 10px; width: 216px; height: 36px; padding: 0 12px; border: 0; background: transparent; color: var(--muted); font: 12px var(--mono); letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: color .2s, background-color .2s; } .ds-nav::before { content: \"\"; width: 6px; height: 6px; transition: background-color .2s, transform .3s var(--ease); } .ds-nav:hover, .ds-nav.active { color: var(--ink); background: var(--surface-2); } .ds-nav.active::before { background: var(--green); transform: rotate(45deg); }"
