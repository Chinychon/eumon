      "css": ".ds-composer { display: flex; align-items: flex-end; gap: 8px; width: min(660px, 100%); padding: 8px 8px 8px 16px; border: 1px solid var(--control-line); background: var(--surface); transition: border-color .2s, box-shadow .2s; } .ds-composer:focus-within { border-color: var(--green); box-shadow: 0 0 0 3px var(--green-soft); } .ds-composer textarea { flex: 1; padding: 8px 0; border: 0; background: transparent; color: var(--ink); font: 15px/1.5 var(--sans); resize: none; outline: none; } .ds-composer button { width: 38px; height: 38px; display: grid; place-items: center; border: 0; background: var(--primary); color: var(--on-primary); cursor: pointer; transition: transform .15s var(--ease), background-color .2s; } .ds-composer button:hover { background: var(--primary-hover); transform: scale(1.06); } .ds-composer button:active { transform: scale(.94); }"
    }
