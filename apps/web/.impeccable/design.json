    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one forward action per view header.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Update analysis</button>",
      "css": ".ds-btn { height: 36px; display: inline-flex; align-items: center; gap: 8px; padding: 0 16px; border: 1px solid transparent; border-radius: 0; font: 500 13px var(--sans); cursor: pointer; transition: background-color .2s, border-color .2s, transform .12s var(--ease); } .ds-btn:active { transform: scale(.97); } .ds-btn:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; } .ds-btn-primary { background: var(--primary); color: var(--on-primary); } .ds-btn-primary:hover { background: var(--primary-hover); }"
    },
